{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "project-access",
  "description": "Least-privilege access to a project directory explicitly selected by the user.",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:resources:allow-close",
    "dialog:allow-open",
    "fs:allow-exists",
    "fs:allow-lstat",
    "fs:allow-open",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-write"
  ]
}
